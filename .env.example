# Ethnos does not load this file automatically. Use:
# uv run --env-file .env ethnos <command>
ETHNOS_DB_PATH=data/ethnos.sqlite
ETHNOS_OLLAMA_HOST=http://localhost:11434
ETHNOS_OLLAMA_MODEL=qwen3.5:9b
ETHNOS_OLLAMA_TIMEOUT=300
ETHNOS_OLLAMA_STRUCTURE_NUM_PREDICT=2048
ETHNOS_OLLAMA_ANSWER_NUM_PREDICT=1536
ETHNOS_OLLAMA_NUM_CTX=4096
# Image questions use heterogeneous readers so one model does not merely repeat
# its own symbol mistake. Override either value to roll back independently.
ETHNOS_OLLAMA_VISION_MODEL=qwen3.5:4b
ETHNOS_OLLAMA_VISION_VERIFIER_MODEL=qwen3.5:9b
ETHNOS_OLLAMA_VISION_NUM_PREDICT=256
# Used for an image question only when exact symbolic handling is unavailable
# and --model was not supplied. Ordinary ethics/history answers keep the
# established ETHNOS_OLLAMA_MODEL default.
ETHNOS_OLLAMA_MATH_MODEL=qwen3.5:4b
ETHNOS_QUESTION_IMAGE_CACHE_DIR=data/cache/question_images
# Interactive region captures and their automatic answer/trace artifacts.
ETHNOS_QUESTION_CAPTURE_DIR=data/runs/captures
# Per-request session retention. The host service may provide a different
# fallback for callers that do not send keep_alive.
ETHNOS_OLLAMA_KEEP_ALIVE=30m
# false is the tuned local default. Use auto to omit the request field, or
# true/low/medium/high for models where thinking improves quality.
ETHNOS_OLLAMA_THINK=false

# Optional benchmark knob. Leave unset for normal use unless a host-specific
# benchmark proves a fixed thread count is faster and still accurate.
ETHNOS_OLLAMA_NUM_THREAD=

# Agent Review defaults. `cpu-local` is a compatibility profile name. The
# command can override these values.
ETHNOS_AGENT_MODEL=qwen3.5:9b
ETHNOS_AGENT_MODEL_PROFILE=cpu-local
ETHNOS_AGENT_ALLOW_WEB=false
ETHNOS_AGENT_VISION_PAGES=auto
