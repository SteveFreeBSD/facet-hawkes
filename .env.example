# Ethnos does not load this file automatically. Use:
# uv run --env-file .env ethnos <command>
ETHNOS_DB_PATH=data/ethnos.sqlite
ETHNOS_OLLAMA_HOST=http://localhost:11434
ETHNOS_OLLAMA_MODEL=gemma-python
ETHNOS_OLLAMA_TIMEOUT=300
ETHNOS_OLLAMA_STRUCTURE_NUM_PREDICT=2048
ETHNOS_OLLAMA_ANSWER_NUM_PREDICT=1536
ETHNOS_OLLAMA_NUM_CTX=4096
# false is the tuned local default. Use auto to omit the request field, or
# true/low/medium/high for models where thinking improves quality.
ETHNOS_OLLAMA_THINK=false

# Optional benchmark knob. Leave unset for normal use unless a host-specific
# benchmark proves a fixed thread count is faster and still accurate.
ETHNOS_OLLAMA_NUM_THREAD=

# Agent Review defaults. `cpu-local` is a compatibility profile name; Ollama
# still uses Vulkan on Caspian. The command can override these values.
ETHNOS_AGENT_MODEL=gemma-python
ETHNOS_AGENT_MODEL_PROFILE=cpu-local
ETHNOS_AGENT_ALLOW_WEB=false
ETHNOS_AGENT_VISION_PAGES=auto
